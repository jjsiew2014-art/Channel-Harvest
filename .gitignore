# ==============================================================================
# Channel Harvest - .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Build & Release Artifacts, Large Binaries (>100MB GitHub limit)
# ------------------------------------------------------------------------------
dist/
build/
release/
bin/
runtime/

# Compressed Archives & Package Formats
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz

# Executables & Installer Formats
*.exe
*.msi
*.dmg
*.pkg
*.iso
*.dll
*.pyd
*.so
*.dylib
*.bin

# ------------------------------------------------------------------------------
# 2. PyInstaller Build Artifacts & Intermediate Files
# ------------------------------------------------------------------------------
*.manifest
*.spec.bak
*.toc
*.pyz

# ------------------------------------------------------------------------------
# 3. Documentation, README & Release Notes
# ------------------------------------------------------------------------------
RELEASE_NOTES_*.md
README*

# ------------------------------------------------------------------------------
# 4. Downloaded Media & Temporary Download Streams
# ------------------------------------------------------------------------------
*.mp4
*.mkv
*.webm
*.mov
*.avi
*.ts
*.flv
*.m4v

*.mp3
*.m4a
*.flac
*.wav
*.aac
*.opus
*.ogg

*.part
*.ytdl
*.temp
*.tmp

# Subtitles, descriptions, metadata & chapters from test/local runs
*.srt
*.vtt
*.description
*.metadata.txt
*.chapters.txt

# Common download output folders
downloads/
output/
test_downloads/

# ------------------------------------------------------------------------------
# 5. Python Bytecode, Caches & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual Environments
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# Packaging & test coverage caches
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# ------------------------------------------------------------------------------
# 6. Logs, Diagnostics & Local Scratch / User Data
# ------------------------------------------------------------------------------
*.log
logs/
scratch/
settings.json
download_archive.txt
test_*.png
test_*.jpg
test_*.json
test_*.txt

# ------------------------------------------------------------------------------
# 7. IDEs, Editors & Operating System Clutter
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
*.bak

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
